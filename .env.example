# Setup creates a private .env.local with the actual local password.
# This file is a template only. Do not commit real credentials.
DATABASE_URL=postgresql://inaya_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/inaya_crm

# Same-origin local application. Local auth/bootstrap secrets are generated in
# an ignored, ACL-restricted file on the first run; never put them in VITE_* vars.
APP_ORIGIN=http://127.0.0.1:4310
PORT=4310
# Production additionally needs explicit AUTH_SECRET, HTTPS, deployment review,
# runtime LTS validation, backup/restore and password recovery arrangements.

# Google connections are deferred. No Google account/key is needed for local coding.
# Leave these disabled until real adapters and quota controls are implemented.
TRANSLATION_PROVIDER=disabled
PUBLIC_ENQUIRY_CAPTURE_ENABLED=false
GOOGLE_ADS_MEASUREMENT_ENABLED=false
