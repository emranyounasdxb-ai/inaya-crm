{
  "name": "inaya-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0",
    "pnpm": "12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/check-runtime.mjs --quiet && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests/crm.test.mjs tests/e2e vite.config.ts drizzle.config.ts playwright.config.ts",
    "format": "biome check --write src tests/crm.test.mjs tests/e2e vite.config.ts drizzle.config.ts playwright.config.ts",
    "start": "node --env-file=.env.local scripts/serve.mjs",
    "dev": "node --watch --env-file=.env.local scripts/serve.mjs",
    "dev:web": "vite",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup.mjs",
    "db:restore-test": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/test-backup-restore.ps1",
    "recover:account": "node --env-file=.env.local scripts/recover-account.mjs",
    "test:crm": "node --env-file=.env.local --test --test-concurrency=1 tests/crm.test.mjs",
    "test:e2e": "playwright test",
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:browser": "node scripts/check-browser-setup.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:integrations": "node scripts/check-runtime.mjs --quiet && tsc -p tsconfig.integrations.json && node --test tests/integrations.test.mjs",
    "check:installation": "pnpm check:dependencies && pnpm check:versions && pnpm check:setup && pnpm check:migrations && pnpm check:integrations && pnpm check:browser && pnpm audit",
    "check:versions": "node scripts/check-toolchain.mjs --runtime",
    "check:setup": "node --env-file=.env.local scripts/check-local-setup.mjs",
    "db:start": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/start-db.ps1",
    "db:stop": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/stop-db.ps1"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@google-cloud/translate": "10.3.0",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.12",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "i18next": "26.5.3",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.60.0",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router": "8.5.0",
    "read-excel-file": "9.3.12",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
